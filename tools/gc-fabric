#!/usr/bin/env node
const fs=require('node:fs');
const {spawnSync}=require('node:child_process');
const REGISTRY='https://glasscastles.vercel.app/api/v1/fabric';
const ALIASES={scope:'scope',sentinel:'scope',scopesentinel:'scope',kork:'discover',discover:'discover',shattered:'assess',shatter:'assess',assess:'assess',witness:'validate',validate:'validate',blast:'impact',impact:'impact',console:'remediate',remediate:'remediate'};
function usage(){console.error('Usage: gc-fabric registry | capabilities [stage|all] | call <stage> <action> [payload.json|-]');process.exitCode=2;}
async function getJson(url,options={}){const c=new AbortController(),t=setTimeout(()=>c.abort(),45000);try{const r=await fetch(url,{...options,signal:c.signal});const text=await r.text();let body;try{body=JSON.parse(text)}catch{body={raw:text}}if(!r.ok)throw Object.assign(new Error(body.error||`HTTP ${r.status}`),{status:r.status,body});return body}finally{clearTimeout(t)}}
function keychainToken(){const x=spawnSync('security',['find-generic-password','-a','glasscastles','-s','com.glasscastles.fabric.agent','-w'],{encoding:'utf8'});return x.status===0?x.stdout.trim():'';}
function stageOf(registry,name){const stage=ALIASES[String(name||'').toLowerCase()]||String(name||'').toLowerCase();const hit=registry.stages.find(x=>x.stage===stage);if(!hit)throw new Error(`Unknown stage: ${name}`);return hit;}
function payloadFrom(arg){if(!arg)return{};const text=arg==='-'?fs.readFileSync(0,'utf8'):fs.readFileSync(arg,'utf8');const x=JSON.parse(text);if(!x||typeof x!=='object'||Array.isArray(x))throw new Error('Payload must be a JSON object.');return x;}
async function capabilities(registry,name){if(!name||name==='all'){const out={contract:'glasscastles.fabric.capabilities.snapshot.v1',generated_at:new Date().toISOString(),stages:{}};for(const s of registry.stages)out.stages[s.stage]=await getJson(new URL(s.capabilities,s.base_url));return out;}const s=stageOf(registry,name);return getJson(new URL(s.capabilities,s.base_url));}
function headers(){const h={'content-type':'application/json'};const token=keychainToken();if(token)h.authorization=`Bearer ${token}`;return h;}
async function call(registry,stageName,action,payload){const stage=stageOf(registry,stageName),networkPath=stage.network?.[action];const url=new URL(networkPath||stage.agent,stage.base_url);const body=networkPath?payload:{action,...payload};return getJson(url,{method:'POST',headers:headers(),body:JSON.stringify(body)});}
async function main(){const [cmd,a,b,c]=process.argv.slice(2);if(!cmd)return usage();const registry=await getJson(REGISTRY);if(cmd==='registry')return console.log(JSON.stringify(registry,null,2));if(cmd==='capabilities')return console.log(JSON.stringify(await capabilities(registry,a||'all'),null,2));if(cmd==='call'){if(!a||!b)return usage();return console.log(JSON.stringify(await call(registry,a,b,payloadFrom(c)),null,2));}usage();}
main().catch(e=>{console.error(JSON.stringify({ok:false,error:e.message,status:e.status||null,body:e.body||null},null,2));process.exitCode=1});
