#!/usr/bin/env node
const fs=require('node:fs');
const {spawnSync}=require('node:child_process');
const REGISTRY='https://glasscastles.vercel.app/api/v1/fabric';
const BOOTSTRAP_SCOPE={stage:'scope',name:'ScopeSentinel',base_url:'https://scopesentinel-saas.vercel.app',capabilities:'/api/v1/capabilities',agent:'/api/v1/agent',openapi:'/openapi.json',bootstrap:true};
const ALIASES={scope:'scope',sentinel:'scope',scopesentinel:'scope',kork:'discover',discover:'discover',shattered:'assess',shatter:'assess',shatterassay:'assess',assess:'assess',witness:'validate',validate:'validate',blast:'impact',impact:'impact',console:'remediate',remediate:'remediate'};
function usage(){console.error('Usage: gc-fabric registry | capabilities [stage|all] | call <stage> <action> [payload.json|-] | ukc <model|analyze-path|coverage|compare-paths> [payload.json|-] | diamond <model|event|pivot|contextualize|thread|group|group-family|activity-attack> [payload.json|-] | pyramid <model|indicator|portfolio|ukc-plan|diamond-overlay> [payload.json|-] | attack <model|catalog|resolve|behavior|coverage|compose> [payload.json|-]');process.exitCode=2;}
async function getJson(url,options={}){const c=new AbortController(),t=setTimeout(()=>c.abort(),45000);try{const r=await fetch(url,{...options,signal:c.signal});const text=await r.text();let body;try{body=JSON.parse(text)}catch{body={raw:text}}if(!r.ok)throw Object.assign(new Error(body.error||`HTTP ${r.status}`),{status:r.status,body});return body}finally{clearTimeout(t)}}
function keychainToken(){const x=spawnSync('security',['find-generic-password','-a','glasscastles','-s','com.glasscastles.fabric.agent','-w'],{encoding:'utf8'});return x.status===0?x.stdout.trim():'';}
function stageOf(registry,name){const stage=ALIASES[String(name||'').toLowerCase()]||String(name||'').toLowerCase();const hit=registry.stages.find(x=>x.stage===stage);if(hit)return hit;if(stage==='scope'){console.error('WARN: public Fabric registry is missing ScopeSentinel; using direct stage-zero bootstrap endpoint. Conformance remains failed until registry is six-stage.');return BOOTSTRAP_SCOPE;}throw new Error(`Unknown stage: ${name}`);}
function payloadFrom(arg){if(!arg)return{};const text=arg==='-'?fs.readFileSync(0,'utf8'):fs.readFileSync(arg,'utf8');const x=JSON.parse(text);if(!x||typeof x!=='object'||Array.isArray(x))throw new Error('Payload must be a JSON object.');return x;}
async function capabilities(registry,name){if(!name||name==='all'){const stages=[...registry.stages];if(!stages.some(x=>x.stage==='scope'))stages.unshift(BOOTSTRAP_SCOPE);const out={contract:'glasscastles.fabric.capabilities.snapshot.v1',generated_at:new Date().toISOString(),registry_drift:!registry.stages.some(x=>x.stage==='scope'),stages:{}};for(const s of stages)out.stages[s.stage]=await getJson(new URL(s.capabilities,s.base_url));return out;}const s=stageOf(registry,name);return getJson(new URL(s.capabilities,s.base_url));}
function headers(){const h={'content-type':'application/json'};const token=keychainToken();if(token)h.authorization=`Bearer ${token}`;return h;}
async function call(registry,stageName,action,payload){const stage=stageOf(registry,stageName),networkPath=stage.network?.[action];const url=new URL(networkPath||stage.agent,stage.base_url);const body=networkPath?payload:{action,...payload};return getJson(url,{method:'POST',headers:headers(),body:JSON.stringify(body)});}
async function ukc(registry,action,arg){const endpoint=registry?.suite?.attack_model?.endpoint||'/api/v1/ukc',url=new URL(endpoint,'https://glasscastles.vercel.app');if(action==='model')return getJson(url);const map={'analyze-path':'analyze_path','coverage':'coverage','compare-paths':'compare_paths'},rpc=map[action];if(!rpc)throw new Error(`Unknown UKC action: ${action}`);return getJson(url,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({action:rpc,input:payloadFrom(arg)})});}
async function diamond(registry,action,arg){const endpoint=registry?.suite?.analysis_models?.relationship?.endpoint||'/api/v1/diamond',url=new URL(endpoint,'https://glasscastles.vercel.app');if(action==='model')return getJson(url);const map={'event':'normalize_event','pivot':'pivot','contextualize':'contextualize','thread':'thread','group':'group','group-family':'group_family','activity-attack':'activity_attack'},rpc=map[action];if(!rpc)throw new Error(`Unknown Diamond action: ${action}`);return getJson(url,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({action:rpc,...payloadFrom(arg)})});}
async function pyramid(registry,action,arg){const endpoint=registry?.suite?.analysis_models?.cost?.endpoint||'/api/v1/pyramid',url=new URL(endpoint,'https://glasscastles.vercel.app');if(action==='model')return getJson(url);const map={'indicator':'normalize_indicator','portfolio':'portfolio','ukc-plan':'ukc_plan','diamond-overlay':'diamond_overlay'},rpc=map[action];if(!rpc)throw new Error(`Unknown Pyramid action: ${action}`);return getJson(url,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({action:rpc,...payloadFrom(arg)})});}
async function attack(registry,action,arg){const endpoint=registry?.suite?.analysis_models?.behavior?.endpoint||'/api/v1/attack',url=new URL(endpoint,'https://glasscastles.vercel.app');if(action==='model')return getJson(url);const map={'catalog':'catalog','resolve':'resolve','behavior':'normalize_behavior','coverage':'coverage','compose':'compose'},rpc=map[action];if(!rpc)throw new Error(`Unknown ATT&CK action: ${action}`);return getJson(url,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({action:rpc,...payloadFrom(arg)})});}
async function main(){const [cmd,a,b,c]=process.argv.slice(2);if(!cmd)return usage();const registry=await getJson(REGISTRY);if(cmd==='registry')return console.log(JSON.stringify(registry,null,2));if(cmd==='capabilities')return console.log(JSON.stringify(await capabilities(registry,a||'all'),null,2));if(cmd==='call'){if(!a||!b)return usage();return console.log(JSON.stringify(await call(registry,a,b,payloadFrom(c)),null,2));}if(cmd==='ukc'){if(!a)return usage();return console.log(JSON.stringify(await ukc(registry,a,b),null,2));}if(cmd==='diamond'){if(!a)return usage();return console.log(JSON.stringify(await diamond(registry,a,b),null,2));}if(cmd==='pyramid'){if(!a)return usage();return console.log(JSON.stringify(await pyramid(registry,a,b),null,2));}if(cmd==='attack'){if(!a)return usage();return console.log(JSON.stringify(await attack(registry,a,b),null,2));}usage();}
main().catch(e=>{console.error(JSON.stringify({ok:false,error:e.message,status:e.status||null,body:e.body||null},null,2));process.exitCode=1});
